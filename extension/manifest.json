{
  "manifest_version": 3,
  "name": "Flowboard Bridge",
  "version": "0.1.5",
  "description": "Local bridge for Google Flow & Flow Music — runs batchexecute RPCs inside flow.google.com and borrows short-lived tokens for flowmusic.app.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "cookies",
    "webRequest",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://www.flowmusic.app/*",
    "https://flowmusic.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://127.0.0.1:8434/*",
    "http://localhost:8434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flowboard Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "flowboard_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
